# Tesla Powerwall Scheduler - Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_PATH=./powerwall.db

# Tesla Fleet API Credentials
# Register your app at https://developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# OAuth Redirect URI - must match what is registered in the Tesla developer portal
# For local dev: http://localhost:3001/api/auth/callback
# For remote dev: http://<your-server-ip>:3001/api/auth/callback
# For production: https://yourdomain.com/api/auth/callback
TESLA_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Tesla Fleet API base URL (change region if needed)
# North America: https://fleet-api.prd.na.vn.cloud.tesla.com
# Europe:        https://fleet-api.prd.eu.vn.cloud.tesla.com
# Asia-Pacific:  https://fleet-api.prd.ap.vn.cloud.tesla.com
TESLA_FLEET_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com

# Google Maps API Key (Required for Auto Storm Watch feature)
# Get your API key from: https://console.cloud.google.com
# Enable the "Geocoding API" for your project
GOOGLE_MAPS_API_KEY=

# Note: Without a Google Maps API key, Auto Storm Watch will be disabled
# but all other features will work normally.

# Push Notification via NTFY (optional)
# Create a unique topic via ntfy.sh
NTFY_TOPIC=

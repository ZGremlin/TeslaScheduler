# Tesla Powerwall Scheduler - Frontend Environment Variables

# API Backend URL
# Leave blank to auto-detect based on current hostname
# Set explicitly if backend is on a different host/port
# Examples:
#   REACT_APP_API_URL=http://192.168.1.100:3001/api
#   REACT_APP_API_URL=http://powerwall-server.local:3001/api
#   REACT_APP_API_URL=https://powerwall.example.com/api
REACT_APP_API_URL=

# Note: Variables must start with REACT_APP_ to be available in React
# Restart the development server after changing .env files
